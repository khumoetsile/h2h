# ---------------------------------------------------------------------------
# Rivalis backend configuration. Copy to `.env` and adjust.
# DEMO MODE: all wallet functionality is simulated. No payment provider is used.
# ---------------------------------------------------------------------------
APP_NAME=Head2Head
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rivalis
DB_PASSWORD=rivalis_pass
DB_NAME=rivalis_dev
# Database used by `npm test` (dropped and recreated on every run)
DB_NAME_TEST=rivalis_test

# Use a long random string in any shared environment
JWT_SECRET=change-me-to-a-long-random-string
# Session lifetime (hours) without / with "remember me"
SESSION_TTL_HOURS=12
SESSION_REMEMBER_TTL_DAYS=30

# Currency label shown to users (Botswana Pula)
CURRENCY_SYMBOL=P
CURRENCY_CODE=BWP

# Demo opponents ("house bots") that can join a waiting match on request.
# Useful for testing solo. They stake demo funds like any other player.
DEMO_BOTS_ENABLED=true

# Background maintenance: how often the server enforces every timer below
# (expired challenges, lock-in/game/action timeouts). A timeout is applied
# within this many seconds of its deadline.
SWEEPER_INTERVAL_SECONDS=5

# ---------------------------------------------------------------------------
# PvP challenge timers — the single source of truth (see README "Timers").
# The server stamps absolute deadlines from these when each phase starts;
# changing a value only affects timers started afterwards.
# ---------------------------------------------------------------------------
# Find Opponent + direct challenges: time for someone to accept (never past kickoff)
CHALLENGE_ACCEPTANCE_TIMEOUT_SECONDS=300
# Skill games: once matched, time for both players to press Lock In
LOCK_IN_TIMEOUT_SECONDS=120
# Skill games: once both are locked in, time to finish the game
LOCKED_GAME_TIMEOUT_SECONDS=600
# Once one player has acted (locked in / finished), time for the other to act
PLAYER_ACTION_TIMEOUT_SECONDS=120
# Grace window for a player whose connection drops before their deadline
RECONNECTION_TIMEOUT_SECONDS=60
# Football: after kickoff, how long to wait for a verifiable result before voiding (full refund)
FOOTBALL_RESULT_TIMEOUT_MINUTES=240
# Allowance for a request sent just before a deadline (network latency)
TIMER_LATENCY_GRACE_MS=2000
# Flat fee for leaving a challenge after BOTH players locked in (charged to the leaver only)
ABANDONMENT_FEE=0.50

# Football fixture data source.
# 'mock' (default): a self-contained simulated provider, clearly labelled
#   isSimulated: true — no API key needed, safe for local dev/testing.
# 'football-data': real fixtures from api.football-data.org. Get a free key
#   at https://www.football-data.org/client/register, then set:
FOOTBALL_PROVIDER=mock
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4
# How often the background job pulls competitions/fixtures and checks for
# results. The free football-data.org plan is rate-limited to ~10 requests
# per minute, and one sync tick alone costs 1 (competitions) + 1 per enabled
# competition (6 by default) = 7 calls — keep this at 60s or higher with
# FOOTBALL_PROVIDER=football-data. The mock provider makes no network calls,
# so a shorter interval (e.g. 20) is fine for local dev/testing with it.
FOOTBALL_SYNC_INTERVAL_SECONDS=60
FOOTBALL_FIXTURE_WINDOW_DAYS=21
